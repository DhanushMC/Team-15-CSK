{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebFetch(domain:api.github.com)",
      "Edit(/.claude/skills/premortem-standupsync/**)",
      "Bash(python -c ' *)",
      "Bash(git -C \"d:\\\\Hackathon\" status)",
      "Bash(git -C \"d:\\\\Hackathon\" log --oneline -3)",
      "Bash(git -C \"d:\\\\Hackathon\" add .claude/settings.json OVERVIEW.md .claude/plugin-audit.log)",
      "Bash(git -C \"d:\\\\Hackathon\" status --short)",
      "Bash(git -C \"d:\\\\Hackathon\" add .claude/settings.json)",
      "Bash(git -C \"d:\\\\Hackathon\" push origin main)",
      "Edit(/.claude/skills/standup-sync/**)",
      "Edit(/.claude/skills/premortem/**)",
      "Bash(git -C 'd:\\\\Hackathon' commit -m ' *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "Write-Output '{\"systemMessage\": \"PreMortem + StandupSync v1.3.0 | Skills: /premortem (governance) · /standup (intelligence) | Try: /standup departments · /premortem risk categories\"}'",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$json = [Console]::In.ReadToEnd() | ConvertFrom-Json; $f = $json.tool_input.file_path; if ($f) { $ts = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss'); $line = $ts + ' | EDIT | ' + $f; Add-Content 'd:\\Hackathon\\.claude\\skill-activity.log' $line }",
            "shell": "powershell",
            "statusMessage": "Logging file activity...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$json = [Console]::In.ReadToEnd() | ConvertFrom-Json; $f = $json.tool_input.file_path; if ($f -match '\\.py$|\\.yml$|\\.yaml$|\\.md$|\\.json$') { $env:PATH = [System.Environment]::GetEnvironmentVariable('PATH','Machine') + ';' + [System.Environment]::GetEnvironmentVariable('PATH','User'); git -C 'd:\\Hackathon' add $f 2>$null }",
            "shell": "powershell",
            "statusMessage": "Auto-staging generated file...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$json = [Console]::In.ReadToEnd() | ConvertFrom-Json; $f = $json.tool_input.file_path; $tracked = @('settings.json','SKILL.md','premortem.md','standup.md','plugin.json'); $name = Split-Path $f -Leaf; if ($tracked -contains $name) { $ts = (Get-Date).ToString('yyyy-MM-dd HH:mm:ss'); try { $hash = (Get-FileHash $f -Algorithm SHA256).Hash } catch { $hash = 'UNREADABLE' }; $entry = $ts + ' | INTEGRITY | ' + $f + ' | SHA256:' + $hash; Add-Content 'd:\\Hackathon\\.claude\\plugin-audit.log' $entry }",
            "shell": "powershell",
            "statusMessage": "Recording plugin integrity...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "Write-Output '{\"systemMessage\": \"PreMortem + StandupSync v1.3.0 ready. /premortem · /standup | Audit: .claude/plugin-audit.log\"}'",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
