{
  "$schema": "https://claude.ai/plugin-schema/v1",

  "name": "premortem-standupsync",
  "displayName": "PreMortem + StandupSync",
  "version": "1.2.0",
  "description": "AI-Powered Predictive DevOps Governance Platform — bridges daily standup intent to safe production deployments across 10 departments via Microsoft Teams, Excel, GitHub, and ArgoCD.",

  "author": {
    "name": "DEWA DevOps / AI Platform Team",
    "email": "dhanush.mc@dewa.gov.ae",
    "org": "Dubai Electricity and Water Authority"
  },

  "license": "MIT",
  "repository": "https://github.com/DhanushMC/Team-15-CSK",

  "createdAt": "2026-05-15",
  "updatedAt": "2026-06-11",

  "compatibility": {
    "claude-code": ">=1.0.0",
    "github-actions": ">=3.0.0"
  },

  "dependencies": {
    "microsoft-graph-api": ">=1.0",
    "microsoft-teams-webhook": "*",
    "anthropic-api": ">=0.25.0",
    "argocd": ">=2.0"
  },

  "extends": null,

  "provides": {
    "standup-intelligence":    "1.0.0",
    "pr-checklist-gate":       "1.0.0",
    "risk-predictor":          "1.0.0",
    "teams-approval-workflow": "1.0.0",
    "excel-task-registry":     "1.0.0",
    "audit-trail":             "1.0.0"
  },

  "skills": [
    {
      "name": "premortem",
      "command": "/premortem",
      "entrypoint": ".claude/commands/premortem.md",
      "canonical": ".claude/skills/premortem-standupsync/SKILL.md",
      "version": "1.2.0"
    }
  ],

  "hooks": [
    {
      "event": "SessionStart",
      "description": "Print available /premortem commands on session open"
    },
    {
      "event": "PostToolUse:Write|Edit",
      "description": "Append timestamped entry to skill-activity.log for every file write or edit"
    },
    {
      "event": "PostToolUse:Write",
      "description": "Auto-stage .py / .yml / .yaml / .md / .json files to git after generation"
    },
    {
      "event": "PostToolUse:Write|Edit",
      "description": "Write SHA-256 tamper-evidence entry to plugin-audit.log when a tracked plugin file changes",
      "trackedFiles": ["settings.json", "SKILL.md", "premortem.md", "plugin.json"]
    },
    {
      "event": "Stop",
      "description": "Print session-ready message with audit log location"
    }
  ],

  "workflows": [
    {
      "name": "standup-checklist",
      "path": ".github/workflows/standup-checklist.yml",
      "triggers": ["pull_request", "pull_request_review", "workflow_dispatch"],
      "description": "PR standup task visibility — posts/updates a single checklist comment. Merge never blocked."
    },
    {
      "name": "pr-analyze",
      "path": ".github/workflows/pr-analyze.yml",
      "triggers": ["pull_request", "workflow_dispatch"],
      "description": "Claude PR diff ↔ standup task correlation (MATCH / PARTIAL / UNKNOWN). Teams alert on PARTIAL/UNKNOWN."
    },
    {
      "name": "standup-sync",
      "path": ".github/workflows/standup-sync.yml",
      "triggers": ["schedule", "push", "workflow_dispatch"],
      "description": "Scheduled standup transcript → Claude → Excel. Manual dispatch with department selector."
    },
    {
      "name": "remediation-deploy",
      "path": ".github/workflows/remediation-deploy.yml",
      "triggers": ["push", "workflow_dispatch"],
      "description": "AI remediation merge gate: validate → ArgoCD sync → task Done → Teams card → audit log."
    }
  ],

  "integrity": {
    "algorithm": "SHA-256",
    "auditLog": ".claude/plugin-audit.log",
    "note": "plugin-audit.log is written automatically by the PostToolUse:Write|Edit hook whenever a tracked file changes. To verify, re-run: python -c \"import hashlib; ...\" or /premortem generate checksums.",
    "checksums": {
      "CLAUDE.md":                                        "sha256:d92c938e009fe38bc4bf705f3ba5e9631326b89db09cbef49d9c7d865e25bca0",
      "CHANGELOG.md":                                     "sha256:8f06dd81b4e09cbc197b808e721b87bc93e1c152921a8d9382f57a9519a35853",
      ".claude/settings.json":                            "sha256:db53a6e170dbbbf83fb630ee43cbacb4d0abb1401be84d66a9d6c3d6495510f4",
      ".claude/commands/premortem.md":                    "sha256:82a6d6e40664383020df129a87b1dc0220ae0c1466eec3f66e4145f86479532a",
      ".claude/skills/premortem-standupsync/SKILL.md":    "sha256:3cb7ddd8cfbcd2619ba60605362749d3a5ace2a79241ecadbc3d1493ef49adfd",
      ".github/workflows/standup-checklist.yml":          "sha256:01755d37e1c6ef3fbecc53b4ca51f1654257fb989f387108de556bd0df8bfa14",
      ".github/workflows/pr-analyze.yml":                 "sha256:629760a6072dc3bba80b4dcde69e0ffa99a870293e2181b87dd5c9dc69493a90",
      ".github/workflows/standup-sync.yml":               "sha256:a2d580d857f9ff859685595adb94ccd9514d30f8b695a19c449deeef1269369a",
      ".github/workflows/remediation-deploy.yml":         "sha256:3833889331a20ae2bfc4ca9e3676bb2e7b4618b36820778da1d6fb04441de36b"
    }
  }
}
